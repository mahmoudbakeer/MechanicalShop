DE
### Get a customer
GET {{baseUrl}}/v1/customers/{{customerJohnId}}
Authorization: Bearer {{token}}

### Get all labors
GET {{baseUrl}}/v1/labors
Authorization: Bearer {{token}}
### Create RepairTask
POST {{baseUrl}}/v1/repair-tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Something Replacement.",
  "duration": 90,
  "laborCost": 100,
  "parts": [
    {
      "name": "Brake pads",
      "cost": 80,
      "quantity": 1
    }
  ]
}

### Update RepairTask
PUT {{baseUrl}}/v1/repair-tasks/{{repairTaskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Something Replacement.",
  "duration": 90,
  "laborCost": 100,
  "parts": [
    {
        "id": "9184629b-e41f-442c-a7c1-388b5ae35090",
      "name": "Brake pads",
      "cost": 80,
      "quantity": 1
    }
  ]
}
### Get all repair task
GET {{baseUrl}}/v1/repair-tasks
Authorization: Bearer {{token}}

### Get a Repair task
GET {{baseUrl}}/v1/repair-tasks/{{repairTaskId}}
Authorization: Bearer {{token}}

### Delete a Repair task
DELETE  {{baseUrl}}/v1/repair-tasks/{{repairTaskId}}
Authorization: Bearer {{token}}


### Get all workorders
GET {{baseUrl}}/v1/workorders
Authorization: Bearer {{token}}


### search workorders
GET {{baseUrl}}/v1/workorders?page=1&pageSize=19&searchTerm=Comp&sortColumn=serviceId
Authorization: Bearer {{token}}


### Get workorder by Id 
GET {{baseUrl}}/v1/workorders/{{workorderId}}
Authorization: Bearer {{token}}

### Create workorder
POST {{baseUrl}}/v1/workorders/
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "VehicleId": "13c80914-41ad-4d46-b7bb-60f6c89ad01e",
  "RepairTaskIds": ["1cb1608c-3bc7-4325-99c3-8244c0fb412f"],
  "laborId": "{{labor02Id}}",
  "startAt": "2023-11-14T17:00:00Z",
  "duration": "01:00:00",
  "Spot" : 2
}



### Update workorder labor
PUT {{baseUrl}}/v1/workorders/{{workorderId}}/labor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "laborId": "{{labor01Id}}"
}

### Update workorder state
PUT {{baseUrl}}/v1/workorders/{{workorderId}}/state
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "NewState": {{Completed}}
}

### delete workorder
DELETE {{baseUrl}}/v1/workorders/{{workorderId}}
Authorization: Bearer {{token}}

### Invoice workorder
POST {{baseUrl}}/v1/invoices/workorders/{{workorderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Get Invoice by Id 
GET {{baseUrl}}/v1/invoices/{{invoiceId}}
Authorization: Bearer {{token}}

### Get Invoice in PDF
GET {{baseUrl}}/v1/invoices/{{invoiceId}}/pdf
Authorization: Bearer {{token}}

### Pay Invoice 
PUT https://localhost:7007/api/v1/invoices/{{invoiceId}}/payment
Authorization: Bearer {{token}}

### Get today schedule workorder
GET {{baseUrl}}/v1/workorders/schedule/2026-10-14
Authorization: Bearer {{token}}
X-TimeZone :  Asia/Kolkata
### Get specific day schedule workorder
GET {{baseUrl}}/v1/workorders/schedule/2025-03-01?laborId=fdbe2dc3-7c0d-4a91-9f33-0a7c1a574f9e
X-TimeZone: America/Montreal
Authorization: Bearer {{token}}