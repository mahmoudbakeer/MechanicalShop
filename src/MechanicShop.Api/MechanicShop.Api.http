### Get OpenAPI document

GET https://localhost:7007/openapi/v1.json

### Get all customers
GET {{baseUrl}}/v1/customers
Authorization: Bearer {{token}}

### Create a Customer
PUT {{baseUrl}}/v1/Customers/a114aa78-a309-4113-9051-a2c945a6caa4
Authorization: Bearer {{token}}
Content-Type:  application/json

{
  "name": "string",
  "email": "string@gmail.com",
  "phoneNumber": "+917873686",
  "vehicle": [
    {
      "id" : "76189ce7-1f2f-4bea-9d03-90dda460f082",
      "make": "string",
      "model": "string",
      "year": 2000,
      "licensePlat": "string"
    }
  ]
}

### DELETE a Customer 
DELETE {{baseUrl}}/v1/Customers/{{customerId}}

